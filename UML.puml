@startuml

' 单例模式
class HeroAircraft {
  - static volatile HeroAircraft instance
  - int locationX, locationY, speedX, speedY
  - int hp, maxHp, power, shootNum, direction
  - int originalShootNum, originalPower
  - long powerUpTime
  - static final long POWER_UP_DURATION
  - ShootStrategy originalShootStrategy
  - long ringShootTime
  - static final long RING_SHOOT_DURATION
  + static getInstance(): HeroAircraft
  + static resetInstance(): void
  + reset(): void
  + increaseHp(int): void
  + increaseMaxHp(int): void
  + decreaseHp(int): void
  + setPowerTo(int): void
  + increasePower(int): void
  + increaseBulletNum(int): void
  + checkPowerUpExpiration(): void
  + activateRingShoot(): void
  + shoot(): List<BaseBullet>
  + forward(): void
}

class PlayerLevelManager {
  - static instance: PlayerLevelManager
  - hero: HeroAircraft
  - level: int
  - exp: int
  - expThresholds: int[]
  - hpBonuses: int[]
  - powerBonuses: int[]
  - static final SHOOT_SPEED_INTERVAL: double = 5
  - static final SHOOT_SPEED_BONUS: double = 0.1
  - static final MAX_SHOOT_SPEED_BONUS: double = 0.5
  + static getInstance(): PlayerLevelManager
  + addExp(int): void
  + getLevel(): int
  + getExp(): int
  + getExpToNextLevel(): int
  + getCurrentThreshold(): int
  + getExpProgress(): double
  + getShootSpeedBonus(): double
  + reset(): void
}

class ImageManager {
  - static CLASSNAME_IMAGE_MAP: Map<String, BufferedImage>
  - static BACKGROUND_IMAGE ~ BACKGROUND_IMAGE5: BufferedImage
  - static HERO_IMAGE, HERO_BULLET_IMAGE, ENEMY_BULLET_IMAGE
  - static MOB_ENEMY_IMAGE, ELITE_ENEMY_IMAGE, ELITE_PLUS_ENEMY_IMAGE
  - static ELITE_PRO_ENEMY_IMAGE, BOSS_IMAGE
  - static HP_DROP_IMAGE, ADD_BULLET_DROP_IMAGE, ADD_BULLET_PLUS_DROP_IMAGE
  - static BOMB_DROP_IMAGE, FREEZE_DROP_IMAGE
  + static get(String): BufferedImage
  + static get(Object): BufferedImage
}

' 工厂模式
interface EnemyAircraftFactory {
  + createAircraft(int, int, int): AbstractAircraft
}

class BossEnemyFactory implements EnemyAircraftFactory {
  + createAircraft(int, int, int): AbstractAircraft
}

class EliteEnemyFactory implements EnemyAircraftFactory {
  + createAircraft(int, int, int): AbstractAircraft
}

class ElitePlusEnemyFactory implements EnemyAircraftFactory {
  + createAircraft(int, int, int): AbstractAircraft
}

class EliteProEnemyFactory implements EnemyAircraftFactory {
  + createAircraft(int, int, int): AbstractAircraft
}

class MobEnemyFactory implements EnemyAircraftFactory {
  + createAircraft(int, int, int): AbstractAircraft
}

class EnemyAircraftFactoryManager {
  - static factoryMap: Map<String, EnemyAircraftFactory>
  + static getFactory(String): EnemyAircraftFactory
}

interface DropFactory {
  + createDrop(int, int, int, int): Drop
}

class AddBulletDropFactory implements DropFactory {
  + createDrop(int, int, int, int): Drop
}

class AddBulletPlusDropFactory implements DropFactory {
  + createDrop(int, int, int, int): Drop
}

class BombDropFactory implements DropFactory {
  + createDrop(int, int, int, int): Drop
}

class FreezeDropFactory implements DropFactory {
  + createDrop(int, int, int, int): Drop
}

class HpDropFactory implements DropFactory {
  + createDrop(int, int, int, int): Drop
}

class DropFactoryManager {
  - static factoryMap: Map<String, DropFactory>
  + static getFactory(String): DropFactory
}

' 策略模式
interface ShootStrategy {
  + shoot(AbstractAircraft): List<BaseBullet>
}

class RingShootStrategy implements ShootStrategy {
  - shootNum: int
  - power: int
  + RingShootStrategy(int, int)
  + shoot(AbstractAircraft): List<BaseBullet>
}

class ScatterShootStrategy implements ShootStrategy {
  - shootNum: int
  - power: int
  - direction: int
  + ScatterShootStrategy(int, int, int)
  + shoot(AbstractAircraft): List<BaseBullet>
}

class StraightShootStrategy implements ShootStrategy {
  - shootNum: int
  - power: int
  - direction: int
  + StraightShootStrategy(int, int, int)
  + shoot(AbstractAircraft): List<BaseBullet>
}

' 观察者模式
interface Observer {
  + update(Observable): void
}

interface Observable {
  + addObserver(Observer): void
  + removeObserver(Observer): void
  + notifyObservers(): void
}

class EnemyObserver implements Observer {
  - enemy: AbstractAircraft
  + EnemyObserver(AbstractAircraft)
  + update(Observable): void
}

' 飞机类
abstract class AbstractFlyingObject {
  - locationX, locationY: int
  - speedX, speedY: int
  - image: BufferedImage
  - width, height: int
  - isValid: boolean
  + forward(): void
  + crash(AbstractFlyingObject): boolean
  + getLocationX(): int
  + getLocationY(): int
  + getImage(): BufferedImage
  + vanish(): void
  + notValid(): boolean
}

abstract class AbstractAircraft extends AbstractFlyingObject {
  - maxHp, hp: int
  - shootStrategy: ShootStrategy
  - freezeEndTime: long
  - originalSpeedX, originalSpeedY: int
  - freezeType: FreezeType
  + decreaseHp(int): void
  + increaseHp(int): void
  + increaseMaxHp(int): void
  + getHp(): int
  + setShootStrategy(ShootStrategy): void
  + shoot(): List<BaseBullet>
  + drop(): List<Drop>
  + updateFreezeState(): void
}

class Boss extends AbstractAircraft {
  - shootNum: int
  - power: int
  - direction: int
  + Boss(int, int, int, int, int)
  + forward(): void
  + drop(): List<Drop>
}

class EliteEnemy extends AbstractAircraft {
  - shootNum: int
  - power: int
  - direction: int
  + EliteEnemy(int, int, int, int, int)
  + forward(): void
  + drop(): List<Drop>
}

class ElitePlusEnemy extends AbstractAircraft {
  - shootNum: int
  - power: int
  - direction: int
  + ElitePlusEnemy(int, int, int, int, int)
  + forward(): void
  + drop(): List<Drop>
}

class EliteProEnemy extends AbstractAircraft {
  - shootNum: int
  - power: int
  - direction: int
  + EliteProEnemy(int, int, int, int, int)
  + forward(): void
  + drop(): List<Drop>
}

class MobEnemy extends AbstractAircraft {
  + MobEnemy(int, int, int, int, int)
  + forward(): void
  + drop(): List<Drop>
}

' 道具类
abstract class Drop extends AbstractFlyingObject {
  - observers: List<Observer>
  + addObserver(Observer): void
  + removeObserver(Observer): void
  + notifyObservers(): void
  + activate(HeroAircraft, Game): void
}

class AddBullet extends Drop {
  + AddBullet(int, int, int, int)
  + activate(HeroAircraft, Game): void
}

class AddBulletPlus extends Drop {
  + AddBulletPlus(int, int, int, int)
  + activate(HeroAircraft, Game): void
}

class Bomb extends Drop {
  + Bomb(int, int, int, int)
  + activate(HeroAircraft, Game): void
}

class Freeze extends Drop {
  + Freeze(int, int, int, int)
  + activate(HeroAircraft, Game): void
}

class Hp extends Drop {
  + Hp(int, int, int, int)
  + activate(HeroAircraft, Game): void
}

' 子弹类
abstract class BaseBullet extends AbstractFlyingObject {
  - power: int
  + getPower(): int
  + setPower(int): void
  + vanish(): void
  + updateFreezeState(): void
}

class EnemyBullet extends BaseBullet {
  + EnemyBullet(int, int, int, int, int)
}

class HeroBullet extends BaseBullet {
  + HeroBullet(int, int, int, int, int)
}

' 游戏类
abstract class Game {
  - timer: Timer
  - heroAircraft: HeroAircraft
  - levelManager: PlayerLevelManager
  - enemyAircrafts: List<AbstractAircraft>
  - heroBullets: List<BaseBullet>
  - enemyBullets: List<BaseBullet>
  - drops: List<Drop>
  - score: int
  - difficultyLevel: int
  - initialDifficulty: int
  + action(): void
  + abstract spawnEnemyAircrafts(): void
  + abstract updateDifficultyLevel(long): void
  + abstract canSpawnBoss(): boolean
  + abstract getBossHp(): int
}

class SimpleGame extends Game {
  + spawnEnemyAircrafts(): void
  + updateDifficultyLevel(long): void
  + canSpawnBoss(): boolean
  + getBossHp(): int
}

class NormalGame extends Game {
  - bossSpawnCount: int
  - bossWarningShown: boolean
  + spawnEnemyAircrafts(): void
  + updateDifficultyLevel(long): void
  + canSpawnBoss(): boolean
  + getBossHp(): int
}

class HardGame extends Game {
  - bossSpawnCount: int
  - bossWarningShown: boolean
  + spawnEnemyAircrafts(): void
  + updateDifficultyLevel(long): void
  + canSpawnBoss(): boolean
  + getBossHp(): int
}

' 关系定义
HeroAircraft ..> HeroAircraft : 单例
PlayerLevelManager ..> PlayerLevelManager : 单例
PlayerLevelManager --> HeroAircraft : 管理

EnemyAircraftFactoryManager ..> EnemyAircraftFactory
DropFactoryManager ..> DropFactory

ShootStrategy <|.. RingShootStrategy
ShootStrategy <|.. ScatterShootStrategy
ShootStrategy <|.. StraightShootStrategy

AbstractAircraft --> ShootStrategy : 使用

Observer <|.. EnemyObserver
Observable <|.. Drop
Drop --> Observer

AbstractFlyingObject <|-- AbstractAircraft
AbstractFlyingObject <|-- BaseBullet
AbstractFlyingObject <|-- Drop

AbstractAircraft <|-- HeroAircraft
AbstractAircraft <|-- EnemyAircraft
EnemyAircraft <|-- Boss
EnemyAircraft <|-- EliteEnemy
EnemyAircraft <|-- ElitePlusEnemy
EnemyAircraft <|-- EliteProEnemy
EnemyAircraft <|-- MobEnemy

Drop <|-- AddBullet
Drop <|-- AddBulletPlus
Drop <|-- Bomb
Drop <|-- Freeze
Drop <|-- Hp

BaseBullet <|-- EnemyBullet
BaseBullet <|-- HeroBullet

Game <|-- SimpleGame
Game <|-- NormalGame
Game <|-- HardGame
Game --> PlayerLevelManager
Game --> HeroAircraft

MobEnemyFactory --> MobEnemy
EliteEnemyFactory --> EliteEnemy
ElitePlusEnemyFactory --> ElitePlusEnemy
EliteProEnemyFactory --> EliteProEnemy
BossEnemyFactory --> Boss

HpDropFactory --> Hp
AddBulletDropFactory --> AddBullet
AddBulletPlusDropFactory --> AddBulletPlus
BombDropFactory --> Bomb
FreezeDropFactory --> Freeze

' 标题
title 飞机大战 - 完整类图
@enduml
